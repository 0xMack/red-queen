# cargo build output (the WASM build is copied into apps/frontend/app/wasm/games by build-wasm.py)
target/
# the maturin editable build puts the compiled extension next to the Python sources
src/games/_native*.pyd
src/games/_native*.so
# ...and a copy moved aside while a running process held the original (AGENTS.md's Windows workaround)
src/games/_native*.pyd.*
