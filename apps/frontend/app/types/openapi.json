{
  "components": {
    "schemas": {
      "ControlAction": {
        "enum": [
          "pause",
          "resume",
          "step"
        ],
        "title": "ControlAction",
        "type": "string"
      },
      "ControlRequest": {
        "properties": {
          "action": {
            "$ref": "#/components/schemas/ControlAction",
            "description": "Control action to apply to a running evolve() call."
          }
        },
        "required": [
          "action"
        ],
        "title": "ControlRequest",
        "type": "object"
      },
      "EvaluationRecord": {
        "properties": {
          "champion_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Champion Ref"
          },
          "created_at": {
            "exclusiveMinimum": 0.0,
            "title": "Created At",
            "type": "number"
          },
          "entrant_id": {
            "description": "Stable id, e.g. 'run:<run_id>' or 'baseline:greedy'.",
            "minLength": 1,
            "title": "Entrant Id",
            "type": "string"
          },
          "entrant_kind": {
            "enum": [
              "champion",
              "baseline",
              "human"
            ],
            "title": "Entrant Kind",
            "type": "string"
          },
          "game": {
            "minLength": 1,
            "title": "Game",
            "type": "string"
          },
          "hardware": {
            "additionalProperties": true,
            "title": "Hardware",
            "type": "object"
          },
          "interface": {
            "description": "Interface id the entrant played under (docs/design/0007).",
            "title": "Interface",
            "type": "string"
          },
          "label": {
            "description": "Human-readable entrant name.",
            "title": "Label",
            "type": "string"
          },
          "metrics": {
            "additionalProperties": true,
            "title": "Metrics",
            "type": "object"
          },
          "protocol": {
            "description": "Versioned evaluation protocol, e.g. 'snake.score.v1'.",
            "minLength": 1,
            "title": "Protocol",
            "type": "string"
          },
          "run_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Run Id"
          }
        },
        "required": [
          "game",
          "protocol",
          "entrant_id",
          "entrant_kind",
          "label",
          "interface",
          "created_at"
        ],
        "title": "EvaluationRecord",
        "type": "object"
      },
      "GenerationStats": {
        "description": "Per-generation summary stats for one run (and, if using islands, one island).",
        "properties": {
          "best_fitness": {
            "description": "Fitness of the best individual in this generation.",
            "title": "Best Fitness",
            "type": "number"
          },
          "champion_ref": {
            "description": "ArtifactStore key for this generation's best individual's stored program.",
            "minLength": 1,
            "title": "Champion Ref",
            "type": "string"
          },
          "diversity": {
            "description": "Population diversity metric for this generation (higher = more diverse).",
            "minimum": 0.0,
            "title": "Diversity",
            "type": "number"
          },
          "extras": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Algorithm-specific numbers for this generation, free-form (e.g. NEAT's species count and its champion's structure size). None for algorithms with nothing extra to say. Kept generic on purpose so a new algorithm needs no telemetry schema change.",
            "title": "Extras"
          },
          "generation": {
            "description": "0-indexed generation number within the run.",
            "minimum": 0.0,
            "title": "Generation",
            "type": "integer"
          },
          "held_out_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "The champion's mean *game score* on games it never trained on, if the job measured it this generation (usually every N generations -- None otherwise). Monitoring only, never used for selection: it's what shows overfitting, i.e. training fitness rising while this falls (docs/design/0007).",
            "title": "Held Out Score"
          },
          "island_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Island id, if the run uses an island model; None for a single population.",
            "title": "Island Id"
          },
          "mean_fitness": {
            "description": "Mean fitness across the generation's population.",
            "title": "Mean Fitness",
            "type": "number"
          },
          "run_id": {
            "description": "Registry-assigned id of the run this generation belongs to.",
            "minLength": 1,
            "title": "Run Id",
            "type": "string"
          },
          "timestamp": {
            "description": "Unix timestamp when this generation's stats were recorded.",
            "exclusiveMinimum": 0.0,
            "title": "Timestamp",
            "type": "number"
          },
          "worst_fitness": {
            "description": "Fitness of the worst individual in this generation.",
            "title": "Worst Fitness",
            "type": "number"
          }
        },
        "required": [
          "run_id",
          "generation",
          "timestamp",
          "best_fitness",
          "mean_fitness",
          "worst_fitness",
          "diversity",
          "champion_ref"
        ],
        "title": "GenerationStats",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "RunInfo": {
        "description": "Metadata for one evolution run, as stored in the RunRegistry.",
        "properties": {
          "config": {
            "additionalProperties": true,
            "description": "Run configuration/hyperparameters as provided at creation.",
            "title": "Config",
            "type": "object"
          },
          "created_at": {
            "description": "Unix timestamp when the run was created.",
            "exclusiveMinimum": 0.0,
            "title": "Created At",
            "type": "number"
          },
          "run_id": {
            "description": "Unique id for this run, assigned at creation.",
            "minLength": 1,
            "title": "Run Id",
            "type": "string"
          },
          "status": {
            "description": "Current lifecycle status of the run.",
            "enum": [
              "running",
              "paused",
              "completed",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          },
          "summary": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Final summary metrics once the run completes, if set.",
            "title": "Summary"
          },
          "updated_at": {
            "description": "Unix timestamp of the last status/summary update.",
            "exclusiveMinimum": 0.0,
            "title": "Updated At",
            "type": "number"
          }
        },
        "required": [
          "run_id",
          "config",
          "status",
          "created_at",
          "updated_at"
        ],
        "title": "RunInfo",
        "type": "object"
      },
      "RunSummary": {
        "description": "What a list of runs shows for each one -- a few numbers and a short trend, not its whole history. The runs\npage used to download every run's full history (13 MB for 115 runs) to draw 60-point sparklines.",
        "properties": {
          "best_fitness": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Highest best_fitness over the whole run (training fitness / return); None if none recorded.",
            "title": "Best Fitness"
          },
          "generations": {
            "description": "Generations (or RL iterations) recorded so far.",
            "minimum": 0.0,
            "title": "Generations",
            "type": "integer"
          },
          "last": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GenerationStats"
              },
              {
                "type": "null"
              }
            ],
            "description": "The latest generation's stats (its extras, its timestamp); None if none recorded."
          },
          "run_id": {
            "minLength": 1,
            "title": "Run Id",
            "type": "string"
          },
          "trend": {
            "description": "best_fitness over the run, downsampled to at most `trend_points` evenly spaced generations (first and last always included).",
            "items": {
              "type": "number"
            },
            "title": "Trend",
            "type": "array"
          }
        },
        "required": [
          "run_id",
          "generations",
          "best_fitness",
          "last",
          "trend"
        ],
        "title": "RunSummary",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "red-queen backend",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/games/{game}/interfaces": {
      "get": {
        "description": "The representations (observer + action adapter) a model can be trained under for `game`.",
        "operationId": "get_interfaces_games__game__interfaces_get",
        "parameters": [
          {
            "in": "path",
            "name": "game",
            "required": true,
            "schema": {
              "title": "Game",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "title": "Response Get Interfaces Games  Game  Interfaces Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Interfaces",
        "tags": [
          "leaderboards"
        ]
      }
    },
    "/games/{game}/leaderboard": {
      "get": {
        "description": "Every evaluation of `game` (optionally one protocol), best mean score first. Records from\ndifferent protocols aren't comparable -- a client showing more than one groups by protocol.",
        "operationId": "get_leaderboard_games__game__leaderboard_get",
        "parameters": [
          {
            "in": "path",
            "name": "game",
            "required": true,
            "schema": {
              "title": "Game",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "protocol",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Protocol"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/EvaluationRecord"
                  },
                  "title": "Response Get Leaderboard Games  Game  Leaderboard Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Leaderboard",
        "tags": [
          "leaderboards"
        ]
      }
    },
    "/games/{game}/models": {
      "get": {
        "description": "Published packages for `game`, per leaderboard entrant, plus `base_url` -- where `blobs/<sha>`\nand `manifests/<id>.json` are fetched from. Empty (not 404) for a game with nothing published.",
        "operationId": "get_catalog_games__game__models_get",
        "parameters": [
          {
            "in": "path",
            "name": "game",
            "required": true,
            "schema": {
              "title": "Game",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Get Catalog Games  Game  Models Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Catalog",
        "tags": [
          "models"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/models/blobs/{sha256}": {
      "get": {
        "operationId": "get_blob_models_blobs__sha256__get",
        "parameters": [
          {
            "in": "path",
            "name": "sha256",
            "required": true,
            "schema": {
              "title": "Sha256",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
