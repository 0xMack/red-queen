            "description": "Validation Error"
          }
        },
        "summary": "Get Blob",
        "tags": [
          "models"
        ]
      }
    },
    "/models/manifests/{package_id}.json": {
      "get": {
        "operationId": "get_manifest_models_manifests__package_id__json_get",
        "parameters": [
          {
            "in": "path",
            "name": "package_id",
            "required": true,
            "schema": {
              "title": "Package Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Manifest",
        "tags": [
          "models"
        ]
      }
    },
    "/runs": {
      "get": {
        "operationId": "list_runs_runs_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RunInfo"
                  },
                  "title": "Response List Runs Runs Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Runs",
        "tags": [
          "runs"
        ]
      }
    },
    "/runs/summaries": {
      "get": {
        "description": "One summary per run, in `list_runs()` order: what a runs list needs, in one request.",
        "operationId": "list_run_summaries_runs_summaries_get",
        "parameters": [
          {
            "in": "query",
            "name": "trend_points",
            "required": false,
            "schema": {
              "default": 60,
              "maximum": 500,
              "minimum": 1,
              "title": "Trend Points",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RunSummary"
                  },
                  "title": "Response List Run Summaries Runs Summaries Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Run Summaries",
        "tags": [
          "runs"
        ]
      }
    },
    "/runs/{run_id}": {
      "get": {
        "operationId": "get_run_runs__run_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunInfo"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Run",
        "tags": [
          "runs"
        ]
      }
    },
    "/runs/{run_id}/artifacts/{ref}": {
      "get": {
        "operationId": "get_artifact_runs__run_id__artifacts__ref__get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "ref",
            "required": true,
            "schema": {
              "title": "Ref",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "kind",
            "required": false,
            "schema": {
              "default": "program",
              "enum": [
                "program",
                "trace"
              ],
              "title": "Kind",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Artifact",
        "tags": [
          "runs"
        ]
      }
    },
    "/runs/{run_id}/artifacts/{ref}/brain": {
      "get": {
        "description": "A champion as plain numbers a game core can be built from (`evolve.networks.compiled`): a layered\nnetwork's weights, or a NEAT genome's compiled evaluation plan. What the browser feeds the Rust\n`CheckersStrategy` -- so no client re-implements NEAT or the weight layout.",
        "operationId": "get_brain_runs__run_id__artifacts__ref__brain_get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "ref",
            "required": true,
            "schema": {
              "title": "Ref",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Get Brain Runs  Run Id  Artifacts  Ref  Brain Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Brain",
        "tags": [
          "runs"
        ]
      }
    },
    "/runs/{run_id}/artifacts/{ref}/package": {
      "post": {
        "description": "Package any stored champion on demand -- how the browser watches a champion that was never\npublished (a still-training run's latest, a pinned generation). Development/live-training only:\nit costs a little server compute per *new* champion, never per frame, and packages are\ncontent-addressed, so asking again for the same champion re-uses the stored one. Unlike\njobs/publish_models.py it measures only numeric parity (on random inputs), not action agreement\non the protocol's games -- so it's marked `on_demand`, and never becomes a leaderboard entrant.",
        "operationId": "export_champion_runs__run_id__artifacts__ref__package_post",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "ref",
            "required": true,
            "schema": {
              "title": "Ref",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Export Champion Runs  Run Id  Artifacts  Ref  Package Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Export Champion",
        "tags": [
          "models"
        ]
      }
    },
    "/runs/{run_id}/control": {
      "post": {
        "operationId": "control_run_runs__run_id__control_post",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ControlRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Control Run",
        "tags": [
          "runs"
        ]
      }
    },
    "/runs/{run_id}/metrics/history": {
